# Ne jamais embarquer dans l'image : environnement local, secrets, bases et fichiers volumineux.
.venv/
.venv313/
venv/
**/__pycache__/
**/*.pyc
.git/
.github/
.claude/
.env
.env.*
backend/db.sqlite3
backend/staticfiles/
backend/media/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
.coverage
backend/.coverage

# Sources brutes de l'ancien site et documents (inutiles au runtime)
backend/sources/
backend/docs/
backend/deploy/
backend/Makefile

# Vidéos d'origine non compressées (les versions web sont dans frontend/static/video/)
frontend/static/*.mp4
frontend/static/*.mov
